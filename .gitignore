# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# OS / editors
# ---------------------------------------------------------------------------
.DS_Store

# ---------------------------------------------------------------------------
# Local archive of superseded scripts and results (kept on disk, not published)
# ---------------------------------------------------------------------------
_archive_bigsoldbt/

# ---------------------------------------------------------------------------
# Dataset. BigSolDB 2.0 is third-party research data (Krasnov et al. 2025) and
# is included for reproducibility — see BigSolDB-T/data/README.md.
# Stray/temporary CSVs dropped into data/ stay ignored.
# ---------------------------------------------------------------------------
BigSolDB-T/data/*.csv
!BigSolDB-T/data/BigSolDBv2.0.csv
!BigSolDB-T/data/BigSolDBv2.0_densities.csv

# ---------------------------------------------------------------------------
# BigSolDB-T regenerable artifacts.
# Rebuilt by the notebooks / scripts; too large or machine-specific to publish.
# Final figures and tables are NOT ignored.
# ---------------------------------------------------------------------------
*.pt
BigSolDB-T/results/preds*/
BigSolDB-T/results/features.npz
BigSolDB-T/results/splits.npz
BigSolDB-T/results/splits_joint.npz

# per-notebook preview images (publication PDFs live in results/final_figures/)
BigSolDB-T/results/fig0*.png
BigSolDB-T/results/fig1*.png

# PNG previews duplicate the final PDFs; keep only those the README embeds
BigSolDB-T/results/final_figures/*.png
!BigSolDB-T/results/final_figures/Fig2_conditioning_slope_recovery.png
!BigSolDB-T/results/final_figures/Fig3_distribution_shift_performance.png

# logs
*.log

# ---------------------------------------------------------------------------
# ESOL project (separate work in this repository)
# ---------------------------------------------------------------------------
ESOL/*.pdf
!ESOL/ESOL_Project.pdf
